{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fearprime",
  "version": "0.1.0",
  "identifier": "dev.jekidev.fearprime",
  "build": {
    "beforeBuildCommand": "bun run generate",
    "frontendDist": "../.output/public",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fearprime personal fear-learning research workspace"
  },
  "app": {
    "windows": [
      {
        "title": "Fearprime",
        "width": 1366,
        "height": 768,
        "minWidth": 375,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
